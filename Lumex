    { keys = {"fire","flame","burn"}, color = Color3.fromRGB(255, 130, 40), tag = "FR" },
    { keys = {"ice","freeze","frost"}, color = Color3.fromRGB(140, 220, 255), tag = "IC" },
    { keys = {"dark","shadow"}, color = Color3.fromRGB(160, 90, 220),  tag = "SH"  },
    { keys = {"strength","strong"}, color = Color3.fromRGB(255, 170, 70), tag = "ST" },
    { keys = {"speed"},         color = Color3.fromRGB(255, 170, 170), tag = "SP"  },
}

local function getPowerStyle(name)
    local l = string.lower(tostring(name or ""))
    for _, entry in ipairs(POWER_STYLES) do
        for _, k in ipairs(entry.keys) do
            if string.find(l, k, 1, true) then return entry.color, entry.tag end
        end
    end
    return Color3.fromRGB(200, 200, 210), "PW"
end

local function getEquippedPower(player)
    if not player then return nil end
    local function valid(v)
        if v == nil then return false end
        local s = tostring(v)
        if s == "" or s == "None" or s == "none" or s == "0" or s == "false" then return false end
        return true
    end
    local p = player:GetAttribute("_EquippedPower")
        or player:GetAttribute("EquippedPower")
        or player:GetAttribute("Power")
        or player:GetAttribute("CurrentPower")
    if valid(p) then return tostring(p) end
    local char = player.Character
    if char then
        local c = char:GetAttribute("_EquippedPower")
            or char:GetAttribute("EquippedPower")
            or char:GetAttribute("Power")
        if valid(c) then return tostring(c) end
        for _, vname in ipairs({"_EquippedPower","EquippedPower","Power"}) do
            local v = char:FindFirstChild(vname, true)
            if v and (v:IsA("StringValue") or v:IsA("NumberValue")) then
                if valid(v.Value) then return tostring(v.Value) end
            end
        end
    end
    return nil
end

local function clearPowersESP(player)
    local obj = PowersESP.Objects[player]
    if obj then
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
        PowersESP.Objects[player] = nil
    end
end
local function clearAllPowersESP()
    for p in pairs(PowersESP.Objects) do clearPowersESP(p) end
    table.clear(PowersESP.Objects)
end

local function updatePowersESP(player)
    if not PowersESP.Enabled then return end
    if player == LP then return end
    local char = player.Character
    local head = char and char:FindFirstChild("Head")
    if not char or not head then clearPowersESP(player); return end

    local power = getEquippedPower(player)
    if not power then clearPowersESP(player); return end

    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if myHrp then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - myHrp.Position).Magnitude
            if d > PowersESP.MaxDist then
                local obj = PowersESP.Objects[player]
                if obj and obj.billboard then obj.billboard.Enabled = false end
                return
            end
        end
    end

    local color, tag = getPowerStyle(power)
    local obj = PowersESP.Objects[player]

    if not obj then
        local bb = Instance.new("BillboardGui")
        bb.Name = "LX_PowerBB"
        bb.Size = UDim2.fromOffset(190, 34)
        bb.StudsOffset = Vector3.new(0, 3.2, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = head
        bb.Parent = head

        local holder = Instance.new("Frame")
        holder.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
        holder.BackgroundTransparency = 0.15
        holder.BorderSizePixel = 0
        holder.Size = UDim2.fromScale(1, 1)
        holder.Parent = bb
        Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 8)

        local holderStroke = Instance.new("UIStroke", holder)
        holderStroke.Thickness = 1.3
        holderStroke.Color = color
        holderStroke.Transparency = 0.1

        local badge = Instance.new("Frame")
        badge.BackgroundColor3 = color
        badge.BorderSizePixel = 0
        badge.Size = UDim2.fromOffset(28, 22)
        badge.Position = UDim2.new(0, 5, 0.5, -11)
        badge.Parent = holder
        Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 6)

        local badgeLabel = Instance.new("TextLabel")
        badgeLabel.BackgroundTransparency = 1
        badgeLabel.Size = UDim2.fromScale(1, 1)
        badgeLabel.Text = tag
        badgeLabel.TextColor3 = Color3.fromRGB(15,15,15)
        badgeLabel.Font = Enum.Font.GothamBlack
        badgeLabel.TextSize = 12
        badgeLabel.Parent = badge

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Position = UDim2.fromOffset(38, 0)
        label.Size = UDim2.new(1, -44, 1, 0)
        label.Text = string.upper(power)
        label.TextColor3 = color
        label.Font = Enum.Font.GothamBold
        label.TextSize = 12
        label.TextStrokeTransparency = 0.4
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.Parent = holder

        obj = { billboard = bb, holder = holder, stroke = holderStroke, badge = badge, badgeLabel = badgeLabel, label = label }
        PowersESP.Objects[player] = obj
    end

    obj.billboard.Enabled = true
    obj.billboard.Adornee = head
    obj.stroke.Color = color
    obj.badge.BackgroundColor3 = color
    obj.badgeLabel.Text = tag
    obj.label.Text = string.upper(power)
    obj.label.TextColor3 = color
end

local powersPlayersConn
local function startPowersESP()
    if PowersESP.Conn then return end
    PowersESP.Conn = RunService.Heartbeat:Connect(function()
        if not PowersESP.Enabled then return end
        for _, player in ipairs(Players:GetPlayers()) do updatePowersESP(player) end
    end)
    if not powersPlayersConn then
        powersPlayersConn = Players.PlayerAdded:Connect(function(p)
            pcall(function()
                p.CharacterAdded:Connect(function()
                    task.wait(0.6)
                    if PowersESP.Enabled then updatePowersESP(p) end
                end)
            end)
        end)
    end
end
local function stopPowersESP()
    if PowersESP.Conn then PowersESP.Conn:Disconnect(); PowersESP.Conn = nil end
    clearAllPowersESP()
end
Players.PlayerRemoving:Connect(function(p) clearPowersESP(p) end)

