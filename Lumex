    kn.BorderSizePixel = 0; kn.Parent = sw
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1,0)
    local state = default or false
    local function upd(animate)
        local ti = animate and Anim.Fast or TweenInfo.new(0)
        if state then
            TweenService:Create(sw, ti, {BackgroundColor3 = C.ACCENT}):Play()
            TweenService:Create(kn, ti, {Position = UDim2.new(1,-19,0.5,-8), BackgroundColor3 = C.KNOB_ON}):Play()
            TweenService:Create(acc, ti, {BackgroundColor3 = C.ACCENT, BackgroundTransparency = 0}):Play()
