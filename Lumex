local function hasBandage()
    local c = LP.Character
    if c and c:FindFirstChild("Bandage") then return true end
    local bp = LP:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild("Bandage") then return true end
    return false
end
local function findBandage()
    local function scan(root)
        for _, ch in ipairs(root:GetChildren()) do
            if ch.Name == "DroppedBandage" then
                local pp = ch:IsA("Model") and (ch.PrimaryPart or ch:FindFirstChildWhichIsA("BasePart", true)) or (ch:IsA("BasePart") and ch)
                if pp then return ch, pp end
            end
        end
    end
    local a, b = scan(Workspace); if a then return a, b end
    local e = Workspace:FindFirstChild("Effects"); if e then local a1,b1 = scan(e); if a1 then return a1,b1 end end
    local l = Workspace:FindFirstChild("Live"); if l then local a1,b1 = scan(l); if a1 then return a1,b1 end end
    return nil
end
AddToggle(Pages.UTILITIES, "Auto Steal Bandages", false, function(v)
    tbl.autoStealBandagesEnabled = v
    if v and not tbl2.stealThread then
        tbl2.stealThread = true
        task.spawn(function()
            while tbl.autoStealBandagesEnabled and tbl2.stealThread do
                if not hasBandage() and not isRLGLRed() then
                    local obj, pp = findBandage()
                    if obj and pp then
                        local c = LP.Character
                        local hrp = c and c:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local saved = hrp.CFrame
                            local targetCF = pp.CFrame
                            hrp.CFrame = targetCF
                            for _ = 1, 10 do
                                if not tbl.autoStealBandagesEnabled or hasBandage() or not obj or not obj.Parent or isRLGLRed() then break end
                                hrp.CFrame = targetCF
                                if typeof(firetouchinterest) == "function" then
                                    pcall(function()
                                        firetouchinterest(hrp, pp, 0); task.wait(0.05); firetouchinterest(hrp, pp, 1)
                                    end)
                                end
                                task.wait(0.1)
                            end
                            if c and c:FindFirstChild("HumanoidRootPart") then c.HumanoidRootPart.CFrame = saved end
                            task.wait(0.5)
                        end
                    end
                end
                task.wait(0.5)
            end
            tbl2.stealThread = nil
        end)
    elseif not v then tbl2.stealThread = nil end
end)

