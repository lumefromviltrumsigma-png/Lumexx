local function findMyRoom()
    local c = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local map = Workspace:FindFirstChild("MingleMap")
    map = map and map:FindFirstChild("AllMingleDoors")
    if not c or not map then return nil end
    for _, door in pairs(map:GetChildren()) do
        local ray = door:FindFirstChild("InsideRoomRayCheck")
        if ray then
            local p = ray.CFrame:PointToObjectSpace(c.Position)
            if math.abs(p.X) <= 10 and math.abs(p.Z) <= 12 and math.abs(p.Y) <= 10 then return door end
        end
    end
end
local closeBusy = false
local function tryCloseDoor(door)
    if not door or closeBusy then return end
    closeBusy = true
    local handle = door:FindFirstChild("DoorHandleOtherSide") or door:FindFirstChild("DoorHandle")
    local prompt = handle and handle:FindFirstChild("CloseDoorPrompt")
    if prompt and fireproximityprompt then
        pcall(function()
            prompt.HoldDuration = 0; prompt.RequiresLineOfSight = false
            prompt.MaxActivationDistance = 9999
            fireproximityprompt(prompt, 0)
        end)
    end
    local be = door:FindFirstChild("OpenOrCloseBD")
    if be and be:IsA("BindableEvent") then pcall(function() be:Fire("Close") end) end
    task.delay(4, function() closeBusy = false end)
end
