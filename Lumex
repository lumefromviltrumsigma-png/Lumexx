local HarmfulEffects = {"RagdollStun","Stun","Stunned","StunEffect","StunHit","Knockback","Knockdown","Knockout","Dazed","Paralyzed","Freeze","Frozen","Sleep","Slow","Slowed","Root","Rooted"}
local function RemoveHarmfulEffects()
    local ch = LP.Character; if not ch then return end
    for _, n in ipairs(HarmfulEffects) do
        local o = ch:FindFirstChild(n); if o then pcall(function() o:Destroy() end) end
    end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if hum and hum:GetAttribute("Stunned") then hum:SetAttribute("Stunned", false) end
end
local function toggleAntiSlow(v)
    HSX.AntiSlow.Enabled = v
    if HSX.AntiSlow.Conn then HSX.AntiSlow.Conn:Disconnect(); HSX.AntiSlow.Conn = nil end
    if v then
        RemoveHarmfulEffects()
        HSX.AntiSlow.Conn = RunService.Heartbeat:Connect(function()
            if not HSX.AntiSlow.Enabled then return end
            RemoveHarmfulEffects()
        end)
    end
end

local function toggleSpeedHack(v)
    HSX.SpeedHack.Enabled = v
    if HSX.SpeedHack.Loop then task.cancel(HSX.SpeedHack.Loop); HSX.SpeedHack.Loop = nil end
    if v then
        HSX.SpeedHack.Loop = task.spawn(function()
            while HSX.SpeedHack.Enabled do
                local ch = LP.Character
                if ch then
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then hum.WalkSpeed = HSX.SpeedHack.Value end
                end
                task.wait(0.1)
            end
        end)
    else
        local ch = LP.Character
        if ch then local hum = ch:FindFirstChildOfClass("Humanoid"); if hum then hum.WalkSpeed = 16 end end
    end
end
local function setSpeedHackValue(v)
    HSX.SpeedHack.Value = math.min(v, 100)
    if HSX.SpeedHack.Enabled then
        local ch = LP.Character
        if ch then local hum = ch:FindFirstChildOfClass("Humanoid"); if hum and hum.Health > 0 then hum.WalkSpeed = HSX.SpeedHack.Value end end
    end
end

