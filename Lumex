local function clampPosition(p)
    local vp = CAM.ViewportSize
    if not vp or vp.X <= 0 then vp = Vector2.new(800, 600) end
    local w = Main.AbsoluteSize.X
    local x = math.clamp(p.X.Offset, -w + 100, vp.X - 100)
    local y = math.clamp(p.Y.Offset, 0, math.max(0, vp.Y - 42))
    return UDim2.new(0, x, 0, y)
end
