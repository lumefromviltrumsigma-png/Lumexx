local function clampPosition(newPos)
    local vp = CAM.ViewportSize
    local w = Main.AbsoluteSize.X
    local x = newPos.X.Offset
    local y = newPos.Y.Offset
    x = math.clamp(x, -w + 60, vp.X - 60)
    y = math.clamp(y, 0, vp.Y - 44)
    return UDim2.new(0, x, 0, y)
end

local dragging, dragStart, startPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = Main.Position
    end
end)
Header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        local newPos = UDim2.new(0, startPos.X.Offset + delta.X, 0, startPos.Y.Offset + delta.Y)
        Main.Position = clampPosition(newPos)
    end
end)

