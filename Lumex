-- NEW 1: TUG Auto Pull OP (Remote-based, wins in 6-7s)
local TugPullOP = { Enabled = false, Remote = nil, Captured = nil, Conn = nil, _hooked = false, _orig = nil, LastFire = 0 }

local function findTugRemote()
    local remotes = RS:FindFirstChild("Remotes")
    if remotes then
        local trb = remotes:FindFirstChild("TemporaryReachedBindable")
        if trb and trb:IsA("RemoteEvent") then return trb end
    end
    local function rec(inst, depth)
        if depth > 6 then return nil end
        for _, ch in ipairs(inst:GetChildren()) do
            if ch:IsA("RemoteEvent") and ch.Name == "TemporaryReachedBindable" then return ch end
            local r = rec(ch, depth + 1)
            if r then return r end
        end
        return nil
    end
    return rec(RS, 0)
end

local function setupTugHook()
    local remote = findTugRemote()
    if not remote then return false end
    TugPullOP.Remote = remote
    if not hookfunction then return true end
    if TugPullOP._hooked then return true end
    pcall(function()
        TugPullOP._orig = hookfunction(remote.FireServer, function(self, ...)
            local packed = table.pack(...)
            TugPullOP.Captured = { ... }
            return TugPullOP._orig(self, table.unpack(packed, 1, packed.n))
        end)
        TugPullOP._hooked = true
    end)
    return true
end

local function fireTugRemote()
    local remote = TugPullOP.Remote or findTugRemote()
    if not remote then return end
    TugPullOP.Remote = remote
    if TugPullOP.Captured and #TugPullOP.Captured > 0 then
        pcall(function() remote:FireServer(unpack(TugPullOP.Captured)) end)
    else
        pcall(function() remote:FireServer({}, {}) end)
    end
end

local function toggleTugPullOP(v)
    TugPullOP.Enabled = v
    if TugPullOP.Conn then TugPullOP.Conn:Disconnect(); TugPullOP.Conn = nil end
    if not v then TugPullOP.Captured = nil; return end
    TugPullOP.Captured = nil
    local didPress = false
    setupTugHook()
    task.spawn(function()
        for i = 1, 20 do
            if not TugPullOP.Enabled then break end
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                for _, d in ipairs(pg:GetDescendants()) do
                    if d.Name == "CircleBase" and d:FindFirstChild("Arrow") and d:FindFirstChild("Medium") then
                        pcall(function() d.Medium.Rotation = d.Arrow.Rotation end)
                        local tb = d:FindFirstChild("TextButton") or d:FindFirstChildWhichIsA("TextButton", true)
                        if tb and firesignal then pcall(firesignal, tb.MouseButton1Click) end
                        break
                    end
                end
            end
            pcall(function()
                local rem = RS:FindFirstChild("Remotes")
                rem = rem and rem:FindFirstChild("TemporaryReachedBindable")
                if rem then
                    rem:FireServer({ GameQTE = true })
                    rem:FireServer({ IHateYou = true })
                end
            end)
            if TugPullOP.Captured and #TugPullOP.Captured > 0 then didPress = true; break end
            task.wait(0.12)
        end
        didPress = true
    end)
    TugPullOP.Conn = RunService.Heartbeat:Connect(function()
        if not TugPullOP.Enabled or not didPress then return end
        local now = tick()
        if now - TugPullOP.LastFire < 0.04 then return end
        TugPullOP.LastFire = now
        if TugPullOP.Captured and #TugPullOP.Captured > 0 then fireTugRemote()
        else
            pcall(function()
                local rem = RS:FindFirstChild("Remotes")
                rem = rem and rem:FindFirstChild("TemporaryReachedBindable")
                if rem then
                    rem:FireServer({ GameQTE = true })
                    rem:FireServer({ IHateYou = true })
                end
            end)
        end
    end)
end

