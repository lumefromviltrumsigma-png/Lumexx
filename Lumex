local silentAimDone = false
local function hookSilentAim()
    if silentAimDone then return end
    silentAimDone = true
    pcall(function()
        local GF = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GunFunctions"))
        local orig = GF.FiredGun
        GF.FiredGun = function(char, pos, data, ...)
            if not tbl.silentAimEnabled or char ~= LP.Character then return orig(char, pos, data, ...) end
            data = data or {}
            local myHRP = char and char:FindFirstChild("HumanoidRootPart")
            if not myHRP then return orig(char, pos, data, ...) end
            local fireFrom = myHRP.Position
            pcall(function()
                local held = char:GetAttribute("HoldingWeapon")
                if held then
                    local w = char:FindFirstChild(held)
                    local ff = w and w:FindFirstChild("FireFrom")
                    if ff then fireFrom = ff.Position end
                end
            end)
            local isGuard = LP:GetAttribute("IsGuard")
            local live = Workspace:FindFirstChild("Live")
            local best, bd = nil, math.huge
            if live then
                for _, ch in pairs(live:GetChildren()) do
                    if ch ~= char and not ch:FindFirstChild("Dead") and not ch:FindFirstChild("IFrame") then
                        local h = ch:FindFirstChild("Humanoid")
                        if not (h and h.Health <= 0) then
                            local head = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChildWhichIsA("BasePart", true)
                            if head then
                                local hrp = ch:FindFirstChild("HumanoidRootPart")
                                local canKill
                                if ch:FindFirstChild("Enemy") or string.match(string.lower(ch.Name), "peabert") then canKill = true
                                elseif isGuard then canKill = (ch:FindFirstChild("GuardCanKill") or (hrp and hrp:FindFirstChild("GuardCanKillLockOn"))) and true or false
                                else
                                    local pfc = Players:GetPlayerFromCharacter(ch)
                                    canKill = (pfc and pfc ~= LP and pfc:GetAttribute("IsGuard")) or ch.Name:match("Rebel") or ch.Name:match("Guard") or ch:FindFirstChild("PlayerCanKill") or ch:FindFirstChild("TypeOfGuard")
                                    canKill = canKill and true or false
                                end
                                local tog = isGuard and ch:FindFirstChild("TypeOfGuard")
                                if tog and not (hrp and hrp:FindFirstChild("GuardCanKillLockOn")) then canKill = false end
                                if canKill then
                                    local d = (head.Position - fireFrom).Magnitude
                                    if d < bd and d < 1000 then bd = d; best = head end
                                end
                            end
                        end
                    end
                end
            end
            if best then
                data.CustomFireFrom = true; data.spread = 0
                pos = best.Position
            end
            return orig(char, pos, data, ...)
        end
    end)
end
