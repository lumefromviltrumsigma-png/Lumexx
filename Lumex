local function findGun()
    local c = LP.Character; if not c then return nil end
    local t = c:FindFirstChildOfClass("Tool")
    if t and (t.Name == "MP5" or t.Name == "Revolver" or t:FindFirstChild("GunScript") or t:FindFirstChild("Client")) then return t end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, ch in pairs(bp:GetChildren()) do
            if ch.Name == "MP5" or ch.Name == "Revolver" or ch:FindFirstChild("GunScript") then
                ch.Parent = c; task.wait(0.1); return ch
            end
        end
    end
end
local function findGuardTarget()
    local c = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not c then return nil end
    local best, bd, bestHRP = nil, math.huge, nil
    local live = Workspace:FindFirstChild("Live")
    if live then
        for _, ch in pairs(live:GetChildren()) do
            if ch.Name:match("Rebel") or ch.Name:match("Guard") then
                local hrp = ch:FindFirstChild("HumanoidRootPart"); local h = ch:FindFirstChild("Humanoid")
                if hrp and h and h.Health > 0 then
                    local d = (c.Position - hrp.Position).Magnitude
                    if d < bd then bd = d; best = ch; bestHRP = hrp end
                end
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p:GetAttribute("IsGuard") == true then
            local ch = p.Character
            if ch then
                local hrp = ch:FindFirstChild("HumanoidRootPart"); local h = ch:FindFirstChild("Humanoid")
                if hrp and h and h.Health > 0 then
                    local d = (c.Position - hrp.Position).Magnitude
                    if d < bd then bd = d; best = ch; bestHRP = hrp end
                end
            end
        end
    end
    return best, bestHRP
end
