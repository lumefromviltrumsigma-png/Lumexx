tbl.tugOfWarAutoPullEnabled = false
tbl.tugOfWarPullHelperEnabled = false
local tugFlag = false
local function angleDiff(a,b) return math.abs((a - b + 180) % 360 - 180) end
local function tugRun()
    if tugFlag then return end
    tugFlag = true
    local pg = LP:FindFirstChild("PlayerGui"); if not pg then tugFlag = false; return end
    local ui = pg:WaitForChild("TugOfWarUIV2", 5); if not ui then tugFlag = false; return end
    local remake = ui:FindFirstChild("TugofWarRemake"); if not remake then tugFlag = false; return end
    local circle = remake:FindFirstChild("CircleBase"); if not circle then tugFlag = false; return end
    while true do
        if tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled then
            local phase
            pcall(function() phase = LP:GetAttribute("TugOfWarPhase") end)
            if phase == "QTE" then break end
            task.wait(0.1)
        else break end
    end
    if not (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) then tugFlag = false; return end
    if not circle.Visible then
        local now = tick()
        while (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) and not circle.Visible and tick() - now < 10 do task.wait(0.1) end
    end
    if not (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) then tugFlag = false; return end
    local arrow = circle:FindFirstChild("Arrow"); if not arrow then tugFlag = false; return end
    local medium = circle:FindFirstChild("Medium") or circle:FindFirstChild("Small") or circle:FindFirstChild("Large")
    if not medium then tugFlag = false; return end
    local strat = LP:GetAttribute("TugOfWarStrategy") or "Standard"
    local tolerance = strat == "Stall" and 14 or 18.2
    tbl3.lastPressTime = 0
    local minInterval = 0.12
    local wasIn = false
    local conn1, conn2
    local function cleanup()
        if conn1 then conn1:Disconnect(); conn1 = nil end
        if conn2 then conn2:Disconnect(); conn2 = nil end
        tugFlag = false
    end
    conn2 = LP.ChildAdded:Connect(function(c) if c.Name == "QTEOver" then cleanup() end end)
    conn1 = RunService.RenderStepped:Connect(function()
        if not arrow or not arrow.Parent or not circle.Visible then cleanup(); return end
        if not (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) then cleanup(); return end
        if not fn4("TugOfWar") then cleanup(); return end
        local rot = arrow.Rotation % 360
        local inZone = angleDiff(medium.Rotation % 360, rot) <= tolerance
        if tbl.tugOfWarPullHelperEnabled then medium.Rotation = rot; inZone = true end
        if tbl.tugOfWarAutoPullEnabled then
            if tbl.tugOfWarPullHelperEnabled then
                if tick() - tbl3.lastPressTime > 0.25 then fn6("space"); tbl3.lastPressTime = tick() end
            else
                local fire = inZone and not wasIn
                if fire then fire = tick() - tbl3.lastPressTime > minInterval end
                if fire then fn6("space"); tbl3.lastPressTime = tick() end
            end
        end
        wasIn = inZone
    end)
    task.spawn(function()
        while tugFlag and (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) and fn4("TugOfWar") do task.wait(1) end
        cleanup()
    end)
end
local function tugLoop()
