            TweenService:Create(kn, ti, {Position = UDim2.new(0,3,0.5,-8), BackgroundColor3 = C.KNOB_OFF}):Play()
            TweenService:Create(acc, ti, {BackgroundColor3 = C.BORDER_LIGHT, BackgroundTransparency = 0.6}):Play()
        end
    end
    upd(false)
    btn.MouseEnter:Connect(function() TweenService:Create(btn, Anim.Fast, {BackgroundColor3 = C.PANEL2}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, Anim.Fast, {BackgroundColor3 = C.PANEL}):Play() end)
