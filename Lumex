        if n == name then
            if not p.Visible then p.Visible = true; p.CanvasPosition = Vector2.zero end
        else p.Visible = false end
    end
    for n, t in pairs(Tabs) do
        if n == name then
            TweenService:Create(t, Anim.Fast, {BackgroundColor3 = C.ACTIVE_BG}):Play()
            if t:FindFirstChild("Lbl") then TweenService:Create(t.Lbl, Anim.Fast, {TextColor3 = C.ACTIVE_FG}):Play() end
