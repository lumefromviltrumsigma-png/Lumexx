local fly = { Enabled = false, Speed = 32, Conn = nil, BV = nil }
local flyKey = Enum.KeyCode.U
local function startFly(toggle)
    if toggle then
        if fly.Enabled then return end
        fly.Enabled = true
        local c = LP.Character; if not c then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not (h and hrp) then return end
        h.UseJumpPower = false; h.AutoRotate = false; h.PlatformStand = true
        if fly.BV then fly.BV:Destroy() end
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(40000,40000,40000); bv.Velocity = Vector3.zero
        bv.Parent = hrp; fly.BV = bv
        fly.Conn = RunService.Heartbeat:Connect(function()
            if not fly.Enabled or not c or not c.Parent then startFly(false); return end
            hrp = c:FindFirstChild("HumanoidRootPart"); h = c:FindFirstChildOfClass("Humanoid")
            if not hrp or not h or h.Health <= 0 then startFly(false); return end
            local cam = Workspace.CurrentCamera; if not cam then return end
            local cf = cam.CFrame
            local mv = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then mv -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then mv += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then mv += cf.UpVector end
            if mv.Magnitude > 0 then bv.Velocity = mv.Unit * fly.Speed else bv.Velocity = Vector3.zero end
        end)
    else
        if not fly.Enabled then return end
        fly.Enabled = false
        if fly.Conn then fly.Conn:Disconnect(); fly.Conn = nil end
        if fly.BV then fly.BV:Destroy(); fly.BV = nil end
        local c = LP.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then pcall(function() h.UseJumpPower = true; h.AutoRotate = true; h.PlatformStand = false; h:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
            local hrp = c:FindFirstChild("HumanoidRootPart"); if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
        end
    end
end
