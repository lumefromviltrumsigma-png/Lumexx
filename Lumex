tbl.autoDodgeEnabled = false
local dodgeConns = {}
local dodgeAnimIds = {"105341857343164","88451099342711","79649041083405","73242877658272","114928327045353","135690448001690","103355259844069","125906547773381","121147456137931","96924216250322","116839849594540","104041807075625","83057176809194","103318207627541","121473077508383","94215646393565","81533666958052"}
local lastDodge = 0
local function clearDodge()
    for _, c in ipairs(dodgeConns) do if c then c:Disconnect() end end
    table.clear(dodgeConns)
end
local function onDodgeAnim(track, hrp)
    if not tbl.autoDodgeEnabled or not fn4("HideAndSeek") then return end
    if tick() - lastDodge < 0.8 then return end
    if not track.Animation then return end
    local id = track.Animation.AnimationId
    local match = false
    for _, v in ipairs(dodgeAnimIds) do if string.find(id, v, 1, true) then match = true; break end end
    if not match then return end
    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp or not hrp then return end
    local d1 = (myHrp.Position - hrp.Position).Magnitude
    local d2 = (myHrp.Position + myHrp.Velocity * 0.7 - hrp.Position + hrp.Velocity * 0.7).Magnitude
    local improvement = d1 - d2
    local dot = hrp.CFrame.LookVector:Dot((myHrp.Position - hrp.Position).Unit)
    local threshold = 10
    if math.abs(myHrp.Position.Y - hrp.Position.Y) > 12 then return end
    local trigger = d1 <= 10 or (d2 <= threshold and improvement > -3) or (d1 <= 20 and improvement > 2)
    if trigger then
        if improvement < -8 and d1 > 8 then trigger = false end
        if d1 > 14 and dot < -0.4 then trigger = false end
    end
    if not trigger then return end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {myChar, hrp.Parent}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local hit = Workspace:Raycast(myHrp.Position, hrp.Position - myHrp.Position, rp)
    if hit then return end
    local dodge = LP.Backpack:FindFirstChild("DODGE!") or myChar:FindFirstChild("DODGE!")
    if not dodge then return end
    pcall(function()
        local bp = LP:FindFirstChild("Backpack")
        local slot = nil
        if bp then
            local n = 1
            for _, ch in ipairs(bp:GetChildren()) do
                if ch:IsA("Tool") then
                    if ch.Name == "DODGE!" then slot = tostring(n); break else n += 1 end
                end
            end
        end
        if slot then
            lastDodge = tick()
            fn6(slot); task.wait(0.05); fn6(slot)
        end
    end)
end
local function bindDodgePlayer(player)
    if player == LP then return end
    local function setup(char)
        task.wait(0.5)
        if not player:GetAttribute("IsHunter") then return end
        local hum = char:FindFirstChild("Humanoid"); local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum and hrp then
            local anim = hum:FindFirstChild("Animator")
            if anim then
                table.insert(dodgeConns, anim.AnimationPlayed:Connect(function(t) onDodgeAnim(t, hrp) end))
            end
        end
    end
    if player.Character then task.spawn(setup, player.Character) end
    table.insert(dodgeConns, player.CharacterAdded:Connect(setup))
    table.insert(dodgeConns, player:GetAttributeChangedSignal("IsHunter"):Connect(function()
        if player.Character then task.spawn(setup, player.Character) end
    end))
end
