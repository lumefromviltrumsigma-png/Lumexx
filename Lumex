local function toggleAutoQTE(state)
    Config.AutoQTE = state
    if state and not tbl2.qteThread then
        tbl2.qteThread = task.spawn(function()
            local tracked = {}
            while Config.AutoQTE do
                local qte = fn7()
                if qte and qte.ActiveButtons then
                    for k, btn in pairs(qte.ActiveButtons) do
                        if not tracked[k] and btn then
                            tracked[k] = true
                            if Config.AutoQTE and qte.ActiveButtons[k] then
                                pcall(function() qte.Pressed(false, qte.ActiveButtons[k]) end)
                            end
                        end
                    end
                    for k in pairs(tracked) do if not qte.ActiveButtons[k] then tracked[k] = nil end end
                else table.clear(tracked) end
                task.wait()
            end
            tbl2.qteThread = nil
        end)
    elseif not state and tbl2.qteThread then
        task.cancel(tbl2.qteThread); tbl2.qteThread = nil
    end
end

