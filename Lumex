local guid = nil
task.spawn(function()
    pcall(function()
        local modules = ReplicatedStorage:WaitForChild("Modules", 5)
        if modules then
            local games = modules:WaitForChild("Games", 5)
            if games then
                local PC = require(games:WaitForChild("PentathlonClient", 5))
                if PC and type(PC) == "table" then
                    local r = PC.RunServerGame
                    if r then
                        PC.RunServerGame = function(a,b,...)
                            if a and a.GUID then guid = a.GUID end
                            local pk = table.pack(...); pk.n = 3 + pk.n - 1
                            table.move(pk, 1, pk.n, 3, pk); pk[1] = a; pk[2] = b
                            return r(table.unpack(pk, 1, pk.n))
                        end
                    end
                    local aa = PC.AddActiveGame
                    if aa then
                        PC.AddActiveGame = function(a)
                            if a and a.GUID then guid = a.GUID end
                            return aa(a)
                        end
                    end
                end
            end
        end
    end)
end)

local function fn8(action, data)
    if not guid then return false end
    local rem = ReplicatedStorage:FindFirstChild("Remotes")
    rem = rem and rem:FindFirstChild("PentathlonRemote")
    if rem then
        if data then rem:FireServer(guid, action, data)
        else rem:FireServer(guid, action) end
        return true
    end
    return false
end

