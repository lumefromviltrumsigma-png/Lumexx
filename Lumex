    lab.Font = Enum.Font.GothamMedium; lab.TextSize = 11
    lab.TextXAlignment = Enum.TextXAlignment.Left; lab.Parent = btn

    local sw = Instance.new("Frame"); sw.Size = UDim2.fromOffset(36,20)
    sw.Position = UDim2.new(1,-46,0.5,-10); sw.BackgroundColor3 = C.SWITCH_OFF
    sw.BorderSizePixel = 0; sw.Parent = btn
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1,0)

    local kn = Instance.new("Frame"); kn.Size = UDim2.fromOffset(14,14)
    kn.Position = UDim2.new(0,3,0.5,-7); kn.BackgroundColor3 = C.KNOB_OFF
    kn.BorderSizePixel = 0; kn.Parent = sw
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1,0)

    local state = default or false
    local function upd(animate)
        local ti = animate and Anim.Fast or TweenInfo.new(0)
        if state then
            TweenService:Create(sw, ti, {BackgroundColor3 = C.ACTIVE}):Play()
            TweenService:Create(kn, ti, {Position = UDim2.new(1,-17,0.5,-7), BackgroundColor3 = C.KNOB_ON}):Play()
        else
            TweenService:Create(sw, ti, {BackgroundColor3 = C.SWITCH_OFF}):Play()
            TweenService:Create(kn, ti, {Position = UDim2.new(0,3,0.5,-7), BackgroundColor3 = C.KNOB_OFF}):Play()
        end
    end
    upd(false)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, Anim.Fast, {BackgroundColor3 = C.PANEL2}):Play()
        TweenService:Create(st, Anim.Fast, {Color = C.BORDER_LIGHT}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, Anim.Fast, {BackgroundColor3 = C.PANEL}):Play()
        TweenService:Create(st, Anim.Fast, {Color = C.BORDER}):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        state = not state
        upd(true)
        if callback then task.spawn(function() pcall(callback, state) end) end
    end)

    return {
        Set = function(_, v)
            state = v and true or false
            upd(true)
            if callback then task.spawn(function() pcall(callback, state) end) end
        end
    }
end

