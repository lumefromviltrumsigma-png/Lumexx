local function getPStyle(n)
    local l = string.lower(tostring(n or ""))
    for _, e in ipairs(PStyles) do for _, k in ipairs(e.keys) do if string.find(l, k, 1, true) then return e.color, e.tag end end end
    return Color3.fromRGB(200,200,210), "PW"
end
local function getPower(p)
    if not p then return nil end
    local function ok(v) if v == nil then return false end local s = tostring(v); if s=="" or s=="None" or s=="none" or s=="0" or s=="false" then return false end return true end
    local v = p:GetAttribute("_EquippedPower") or p:GetAttribute("EquippedPower") or p:GetAttribute("Power")
    if ok(v) then return tostring(v) end
    local ch = p.Character
    if ch then local c = ch:GetAttribute("_EquippedPower") or ch:GetAttribute("EquippedPower"); if ok(c) then return tostring(c) end end
    return nil
end
local function clearPESP(p) local o = PESP.Objects[p]; if o then if o.billboard then pcall(function() o.billboard:Destroy() end) end; PESP.Objects[p] = nil end end
local function updatePESP(p)
    if not PESP.Enabled or p == LP then return end
    local ch = p.Character; local head = ch and ch:FindFirstChild("Head")
    if not ch or not head then clearPESP(p); return end
    local pw = getPower(p); if not pw then clearPESP(p); return end
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if myHrp then
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - myHrp.Position).Magnitude > PESP.MaxDist then
            local o = PESP.Objects[p]; if o and o.billboard then o.billboard.Enabled = false end; return
        end
    end
    local color, tag = getPStyle(pw)
    local o = PESP.Objects[p]
    if not o then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.fromOffset(190,34); bb.StudsOffset = Vector3.new(0,3.2,0); bb.AlwaysOnTop = true; bb.Adornee = head; bb.Parent = head
        local holder = Instance.new("Frame"); holder.BackgroundColor3 = Color3.fromRGB(12,12,15); holder.BackgroundTransparency = 0.15; holder.BorderSizePixel = 0; holder.Size = UDim2.fromScale(1,1); holder.Parent = bb
        Instance.new("UICorner", holder).CornerRadius = UDim.new(0,8)
        local hs = Instance.new("UIStroke", holder); hs.Thickness = 1.3; hs.Color = color
        local badge = Instance.new("Frame"); badge.BackgroundColor3 = color; badge.BorderSizePixel = 0; badge.Size = UDim2.fromOffset(28,22); badge.Position = UDim2.new(0,5,0.5,-11); badge.Parent = holder
        Instance.new("UICorner", badge).CornerRadius = UDim.new(0,6)
        local bl = Instance.new("TextLabel"); bl.BackgroundTransparency = 1; bl.Size = UDim2.fromScale(1,1); bl.Text = tag; bl.TextColor3 = Color3.fromRGB(15,15,15); bl.Font = Enum.Font.GothamBlack; bl.TextSize = 12; bl.Parent = badge
        local lb = Instance.new("TextLabel"); lb.BackgroundTransparency = 1; lb.Position = UDim2.fromOffset(38,0); lb.Size = UDim2.new(1,-44,1,0); lb.Text = string.upper(pw); lb.TextColor3 = color; lb.Font = Enum.Font.GothamBold; lb.TextSize = 12; lb.TextStrokeTransparency = 0.4; lb.TextXAlignment = Enum.TextXAlignment.Left; lb.TextTruncate = Enum.TextTruncate.AtEnd; lb.Parent = holder
