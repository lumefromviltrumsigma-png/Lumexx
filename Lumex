local ragdollNames = {"Ragdoll","Stun","RotateDisabled","RagdollWakeupImmunity","RagdollWakeupImmunityLess","StopLoopTpFix","TrueStun","Waiting","waitbeforecheckingforground"}
local ragdollClear = {"Ragdoll","TrueStun","Stun","RotateDisabled","Waiting"}
local function clearRagdollObjs(root)
    for _, n in ipairs(ragdollNames) do
        local o = root:FindFirstChild(n); if o then o.Parent = nil end
    end
end
local function fixJoints(root)
    local torso = root:FindFirstChild("Torso"); if not torso then return end
    for _, ch in ipairs(torso:GetChildren()) do
        if ch:IsA("BallSocketConstraint") and ch.Name:match("^SocketConstraint") then ch.Enabled = false; ch.Parent = nil end
    end
    for _, n in ipairs(jointNames) do
        local m = torso:FindFirstChild(n)
        if m and m:IsA("Motor6D") and not m.Part0 then m.Part0 = torso end
    end
end
local function fixHRP(root)
    local hrp = root:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    for _, ch in ipairs(hrp:GetChildren()) do
        if ch.Name:match("^CacheAttachment") or ch.Name:match("^SocketConstraint") then ch.Parent = nil end
        if ch:IsA("BodyVelocity") or ch:IsA("BodyForce") or ch:IsA("BodyPosition") then ch.Parent = nil end
    end
end
local function fixRagdoll(c)
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    clearRagdollObjs(c)
    h.PlatformStand = false; h.AutoRotate = true
    h:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
    h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    h:SetStateEnabled(Enum.HumanoidStateType.Running, true)
    h:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
    h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    h:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
    h:ChangeState(Enum.HumanoidStateType.GettingUp)
    if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0) end
    fixJoints(c); fixHRP(c)
    h.WalkSpeed = walkSpeed; h.JumpPower = jumpPower
    if shared then shared.WalkSpeedChangeTick = nil end
    task.delay(0.1, function()
        if h and h.Parent and h.Health > 0 then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
end
local function clearAntiPush()
    for _, c in ipairs(antiPushConns) do if c then c:Disconnect() end end
    table.clear(antiPushConns)
end
local function bindAntiPush(c)
    if not tbl.antiPushEnabled then return end
    clearAntiPush()
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local dead = false
    table.insert(antiPushConns, c.ChildAdded:Connect(function(ch)
        if dead or not tbl.antiPushEnabled then return end
        if typeof(ch) == "Instance" then
            for _, n in ipairs(ragdollClear) do
                if ch.Name == n then task.spawn(function() fixRagdoll(c) end); break end
            end
        end
    end))
    table.insert(antiPushConns, RunService.Heartbeat:Connect(function()
        if not tbl.antiPushEnabled then clearAntiPush(); return end
        if not c or not c.Parent then clearAntiPush(); return end
        if not h or not h.Parent or h.Health <= 0 then dead = true; clearAntiPush(); return end
        clearRagdollObjs(c)
        if h.PlatformStand then h.PlatformStand = false; h:ChangeState(Enum.HumanoidStateType.GettingUp) end
        if h.WalkSpeed <= 0 then h.WalkSpeed = walkSpeed; if shared then shared.WalkSpeedChangeTick = nil end end
        if h.JumpPower <= 0 then h.JumpPower = jumpPower end
        if not h.AutoRotate then h.AutoRotate = true end
        if not h:GetStateEnabled(Enum.HumanoidStateType.Jumping) then h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end
        if not h:GetStateEnabled(Enum.HumanoidStateType.Running) then h:SetStateEnabled(Enum.HumanoidStateType.Running, true) end
        if not h:GetStateEnabled(Enum.HumanoidStateType.GettingUp) then h:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true) end
        local torso = c:FindFirstChild("Torso")
        if torso then
            for _, ch in ipairs(torso:GetChildren()) do
                if ch:IsA("BallSocketConstraint") and ch.Name:match("^SocketConstraint") and ch.Enabled then fixJoints(c); break end
            end
        end
        if hrp and hrp.Parent then
            for _, ch in ipairs(hrp:GetChildren()) do
                if ch:IsA("BodyVelocity") or ch:IsA("BodyForce") then ch.Parent = nil end
            end
        end
    end))
end
