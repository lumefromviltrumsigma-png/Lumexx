local Pages, Tabs = {}, {}
local currentPageName = nil

local function CreatePage(name)
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.fromScale(1,1); page.BackgroundTransparency = 1
    page.BorderSizePixel = 0; page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = C.BORDER_LIGHT
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new(0,0,0,0); page.Visible = false; page.Parent = Content
    page.ScrollingDirection = Enum.ScrollingDirection.Y
    local pad = Instance.new("UIPadding", page)
    pad.PaddingRight = UDim.new(0,4); pad.PaddingBottom = UDim.new(0,8); pad.PaddingTop = UDim.new(0,2)
    pad.Parent = page
    local lay = Instance.new("UIListLayout", page)
    lay.Padding = UDim.new(0,6); lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Parent = page
    Pages[name] = page
    return page
end

local function SwitchPage(name)
    currentPageName = name
    for n, p in pairs(Pages) do p.Visible = (n == name) end
    for n, t in pairs(Tabs) do
        if n == name then
            TweenService:Create(t, Anim.Fast, {BackgroundColor3 = C.ACTIVE, TextColor3 = Color3.fromRGB(12,12,14)}):Play()
        else
            TweenService:Create(t, Anim.Fast, {BackgroundColor3 = C.PANEL2, TextColor3 = C.MUTED}):Play()
        end
    end
end

local function CreateTab(name)
    local tab = Instance.new("TextButton")
    tab.Size = UDim2.fromOffset(IS_MOBILE and 86 or 78, 26)
    tab.BackgroundColor3 = C.PANEL2; tab.BorderSizePixel = 0
    tab.Text = name; tab.TextColor3 = C.MUTED
    tab.Font = Enum.Font.GothamBold; tab.TextSize = 8
    tab.AutoButtonColor = false; tab.Parent = TabScroll
    Instance.new("UICorner", tab).CornerRadius = UDim.new(0,6)
    Tabs[name] = tab
    tab.MouseButton1Click:Connect(function()
        if currentPageName == name then return end
        SwitchPage(name)
    end)
    tab.MouseEnter:Connect(function()
        if currentPageName ~= name then
            TweenService:Create(tab, Anim.Fast, {BackgroundColor3 = C.PANEL3}):Play()
        end
    end)
    tab.MouseLeave:Connect(function()
        if currentPageName ~= name then
            TweenService:Create(tab, Anim.Fast, {BackgroundColor3 = C.PANEL2}):Play()
        end
    end)
    return tab
end

