local function processGlass(model)
    if not model:IsA("Model") or not model.PrimaryPart then return end
    local pp = model.PrimaryPart
    local isFake = pp:GetAttribute("exploitingisevil")
    if glassESP and not glassHL[model] then
        local h = Instance.new("Highlight")
        h.FillTransparency = 0.5
        if isFake then h.FillColor = Color3.fromRGB(255,50,50) else h.FillColor = Color3.fromRGB(50,255,50) end
        h.OutlineColor = Color3.new(1,1,1); h.Adornee = model; h.Parent = model
        glassHL[model] = h
    end
    if fakeSafe and isFake and not glassFake[model] then
        local p = Instance.new("Part")
        p.Size = pp.Size; p.CFrame = pp.CFrame * CFrame.new(0,1,0)
        p.Anchored = true; p.CanCollide = true; p.Transparency = 0.5
        p.Color = Color3.fromRGB(50,255,50); p.Material = Enum.Material.Glass
        pcall(function() p.CollisionGroup = "FakeGlass" end)
        p.Parent = Workspace; glassFake[model] = p
    end
end
local function clearGlass()
    for _, h in pairs(glassHL) do if h and h.Parent then h:Destroy() end end
    for _, p in pairs(glassFake) do if p and p.Parent then p:Destroy() end end
    table.clear(glassHL); table.clear(glassFake)
end
local glassThread
local function glassLoop()
    if glassThread then return end
    glassThread = task.spawn(function()
        while glassESP or fakeSafe do
            local gb = Workspace:FindFirstChild("GlassBridge")
            if gb then
                local gh = gb:FindFirstChild("GlassHolder")
                if gh then
                    for _, child in ipairs(gh:GetChildren()) do
                        for _, ch2 in ipairs(child:GetChildren()) do processGlass(ch2) end
                    end
                end
            end
            task.wait(2)
        end
        glassThread = nil
    end)
end
