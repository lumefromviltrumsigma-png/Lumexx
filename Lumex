local WonFarm = { Enabled = false, Thread = nil, Console = nil, Module = nil, LastScan = 0 }

local function GetArcadeConsole()
    if WonFarm.Console and WonFarm.Console.Parent then return WonFarm.Console end
    if tick() - WonFarm.LastScan < 2 then return WonFarm.Console end
    WonFarm.LastScan = tick()
    local roots = {}
    local arcadeRoot = Workspace:FindFirstChild("ArcadeGames") or Workspace:FindFirstChild("Arcades") or Workspace:FindFirstChild("PlayableArcadeGame")
    if arcadeRoot then table.insert(roots, arcadeRoot) else table.insert(roots, Workspace) end
    for _, root in ipairs(roots) do
        local count = 0
        for _, d in ipairs(root:GetDescendants()) do
            count += 1
            if count % 400 == 0 then task.wait() end
            local s = d:FindFirstChild("Screen")
            if s and s:FindFirstChild("SurfaceGui") then
                WonFarm.Console = d
                return d
            end
        end
    end
    return nil
end

local function GetArcadeModule()
    if WonFarm.Module then return WonFarm.Module end
    local ok, m = pcall(function()
        local mods = ReplicatedStorage:WaitForChild("Modules", 5)
        return mods and require(mods:WaitForChild("PlayableArcadeGame", 5))
    end)
    if ok and m then WonFarm.Module = m end
    return WonFarm.Module
end

local function RunOneArcade()
    local console = GetArcadeConsole()
    local mod = GetArcadeModule()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (console and mod and hrp) then return false end
    local game
    local ok = pcall(function()
        game = mod.new(console, hrp)
        game:start()
    end)
    if not ok or not game then return false end
    local t0 = tick()
    while game.State ~= "Running" and tick() - t0 < 3 do
        if not WonFarm.Enabled then
            pcall(function() game.Stopping = true; game:Destroy() end); return false
        end
        task.wait()
    end
    if game.State ~= "Running" then
        pcall(function() game:Destroy() end); return false
    end
    pcall(function()
        game.Score = 4499
        if game.ScoreLabel then game.ScoreLabel.Text = "Score: 4499" end
        if game.CalculateScore then
            table.clear(game.CalculateScore)
            for _ = 1, 99 do table.insert(game.CalculateScore, "Coin") end
        end
        game:win("You Won! Congrats! :D")
    end)
    return true
end

local function ToggleWonFarm(state)
    WonFarm.Enabled = state and true or false
    if WonFarm.Thread then task.cancel(WonFarm.Thread); WonFarm.Thread = nil end
    if WonFarm.Enabled then
