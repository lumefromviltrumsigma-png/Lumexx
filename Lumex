local function tpRelative(x,y,z)
    local char = LP.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(x,y,z)
    end
end
local function findPart(names)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            for _, t in ipairs(names) do if n == t then return obj end end
        end
    end
end
local function tpToBase()
    local char = LP.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then root.CFrame = obj.CFrame + Vector3.new(0,4,0); return end
    end
    local base = findPart({"base","spawn","basespawn","playerspawn","spawnlocation"})
    if base then root.CFrame = base.CFrame + Vector3.new(0,4,0) end
end
local function tpToRoof()
    local char = LP.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
    local roof = findPart({"roof","rooftop","roofpart","top","rooftopspawn"})
    if roof then root.CFrame = roof.CFrame + Vector3.new(0,5,0); return end
    local highest, hy = nil, -math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.CanCollide and obj.Size.X > 3 and obj.Size.Z > 3 then
            if obj.Position.Y > hy then hy = obj.Position.Y; highest = obj end
        end
    end
    if highest then root.CFrame = highest.CFrame + Vector3.new(0, highest.Size.Y/2 + 5, 0) end
end

