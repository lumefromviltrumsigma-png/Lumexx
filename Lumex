    if v then
        HSX.AutoNext.Conn = RunService.Heartbeat:Connect(function(dt)
            if not HSX.AutoNext.Enabled then return end
            local ch = LP.Character
            local pos = ch and ch.PrimaryPart and ch.PrimaryPart.Position
            if pos and (pos - HSX.AutoNext.Target).Magnitude <= HSX.AutoNext.Radius then
                HSX.AutoNext.Timer += dt
                if HSX.AutoNext.Timer >= 3.4 then
                    HSX.AutoNext.Timer = 0
                    pcall(function() RS:WaitForChild("Remotes"):WaitForChild("TemporaryReachedBindable"):FireServer() end)
                end
            else HSX.AutoNext.Timer = 0 end
        end)
    end
end

