-- NEW 3: Rebel Guard Hitbox (expand head size)
local RGH = { Enabled = false, Conn = nil, Size = 6, Originals = {} }
local function isGuardModel(m)
    if not m or not m:IsA("Model") then return false end
    if m == LP.Character then return false end
    if Players:GetPlayerFromCharacter(m) then return false end
    if m:FindFirstChild("Dead") then return false end
    local hum = m:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local n = m.Name
    local ln = string.lower(n)
    if m:FindFirstChild("TypeOfGuard") then return true end
    if string.find(n, "RebelGuard") or string.find(n, "FinalRebel") or string.find(n, "HallwayGuard") or string.find(ln, "aggro") or string.find(ln, "guard") or m:GetAttribute("IsGuard") or m:GetAttribute("GuardTier") ~= nil or m:FindFirstChild("Guard") then
        return true
    end
    return false
end
local function collectGuards()
    local out, seen = {}, {}
    local roots = { Workspace:FindFirstChild("Live"), Workspace:FindFirstChild("NPCs"), Workspace:FindFirstChild("Characters"), Workspace }
    for _, root in ipairs(roots) do
        if root then
            for _, c in ipairs(root:GetChildren()) do
                if not seen[c] and isGuardModel(c) then seen[c] = true; table.insert(out, c) end
            end
            if root ~= Workspace then
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("Model") and not seen[d] and isGuardModel(d) then seen[d] = true; table.insert(out, d) end
                end
            end
        end
    end
    return out
end
local function toggleRGH(v)
    RGH.Enabled = v
    if RGH.Conn then RGH.Conn:Disconnect(); RGH.Conn = nil end
    if not v then
        for _, orig in pairs(RGH.Originals) do
            pcall(function()
                if orig.head and orig.head.Parent then
                    orig.head.Size = orig.size; orig.head.CanCollide = orig.canCollide
                end
            end)
        end
        RGH.Originals = {}; return
    end
    RGH.Conn = RunService.Heartbeat:Connect(function()
        if not RGH.Enabled then return end
        local vec = Vector3.new(RGH.Size, RGH.Size, RGH.Size)
        local alive = {}
        for _, m in ipairs(collectGuards()) do
            alive[m] = true
            local head = m:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                if not RGH.Originals[m] then
                    RGH.Originals[m] = { head = head, size = head.Size, canCollide = head.CanCollide }
                end
                pcall(function()
                    if head.Size ~= vec then head.Size = vec; head.CanCollide = false end
                end)
            end
        end
        for k, o in pairs(RGH.Originals) do
            if not alive[k] or not k.Parent then
                pcall(function() if o.head and o.head.Parent then o.head.Size = o.size; o.head.CanCollide = o.canCollide end end)
                RGH.Originals[k] = nil
            end
        end
    end)
end

-- NEW 4: Rebel Guard ESP (highlight with distance)
local RGE = { Enabled = false, Conn = nil, Objects = {} }
local function toggleRGE(v)
    RGE.Enabled = v
    if RGE.Conn then RGE.Conn:Disconnect(); RGE.Conn = nil end
    for k, o in pairs(RGE.Objects) do
        pcall(function() if o.hl then o.hl:Destroy() end; if o.bb then o.bb:Destroy() end end)
    end
    table.clear(RGE.Objects)
    if not v then return end
    local acc = 0
    RGE.Conn = RunService.Heartbeat:Connect(function(dt)
        if not RGE.Enabled then return end
        acc += dt or 0.016
        if acc < 0.12 then return end
        acc = 0
        local alive = {}
        local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        for _, m in ipairs(collectGuards()) do
            alive[m] = true
            local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if hrp then
                local o = RGE.Objects[m]
                if not o then
                    local hl = Instance.new("Highlight")
                    hl.Adornee = m; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillColor = Color3.fromRGB(255,50,50); hl.OutlineColor = Color3.new(1,1,1)
                    hl.FillTransparency = 0.45; hl.OutlineTransparency = 0
                    hl.Parent = m
                    local bb = Instance.new("BillboardGui")
                    bb.Adornee = hrp; bb.AlwaysOnTop = true
                    bb.Size = UDim2.fromOffset(120,30); bb.StudsOffset = Vector3.new(0,3,0)
                    bb.Parent = hrp
                    local lbl = Instance.new("TextLabel")
                    lbl.BackgroundTransparency = 1; lbl.Size = UDim2.fromScale(1,1)
                    lbl.Font = Enum.Font.Oswald; lbl.TextSize = 14
                    lbl.TextColor3 = Color3.fromRGB(255,80,80); lbl.TextStrokeTransparency = 0.5
                    lbl.Text = "Guard"; lbl.Parent = bb
                    RGE.Objects[m] = { hl = hl, bb = bb, lbl = lbl }
                elseif o.lbl then
                    local dist = 0
                    if myHrp then dist = math.floor((hrp.Position - myHrp.Position).Magnitude) end
                    o.lbl.Text = "Guard [" .. tostring(dist) .. "]"
                end
            end
        end
        for k, o in pairs(RGE.Objects) do
            if not alive[k] then
                pcall(function() if o.hl then o.hl:Destroy() end; if o.bb then o.bb:Destroy() end end)
                RGE.Objects[k] = nil
            end
        end
    end)
end

