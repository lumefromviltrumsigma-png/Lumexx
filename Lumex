local PowersESP = { Enabled = false, Conn = nil, Objects = {}, MaxDist = 500 }

local POWER_STYLES = {
    { keys = {"ultra","instinct"}, color = Color3.fromRGB(80, 220, 255),  tag = "UI"  },
    { keys = {"lightning","thunder"}, color = Color3.fromRGB(255, 220, 60), tag = "LG"  },
